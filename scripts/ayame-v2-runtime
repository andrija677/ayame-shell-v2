#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export AYAME_V2_RUNTIME=1
export AYAME_V2_NOTIFICATION_SERVER=1
: "${AYAME_V2_DATA_DIR:=${XDG_DATA_HOME:-$HOME/.local/share}/ayame-shell-v2/data}"
export AYAME_V2_DATA_DIR
mkdir -p "$AYAME_V2_DATA_DIR"
exec qs --path "$project_dir/config/quickshell" "$@"
