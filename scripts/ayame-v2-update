#!/usr/bin/env bash
set -euo pipefail

archive_url="https://github.com/andrija677/ayame-shell-v2/archive/refs/heads/main.tar.gz"
install_dir="${AYAME_V2_INSTALL_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/ayame-shell-v2}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/ayame-shell-v2"
log_file="$state_dir/update.log"
temporary_dir="$(mktemp -d)"
trap 'rm -rf -- "$temporary_dir"' EXIT
mkdir -p "$state_dir"

printf '[%s] Checking for Ayame Shell V2 updates\n' \
    "$(date --iso-8601=seconds)" >> "$log_file"
curl -fsSL "$archive_url" -o "$temporary_dir/ayame-shell-v2.tar.gz" \
    2>> "$log_file"
mkdir -p "$temporary_dir/source"
tar -xzf "$temporary_dir/ayame-shell-v2.tar.gz" \
    --strip-components=1 -C "$temporary_dir/source" 2>> "$log_file"

"$temporary_dir/source/scripts/check" >> "$log_file" 2>&1

update_available=false
for payload in config docs scripts tests README.md install.sh uninstall.sh; do
    if [[ ! -e "$install_dir/$payload" ]] \
            || ! diff -qr --exclude=__pycache__ --exclude='*.py[co]' \
                "$temporary_dir/source/$payload" \
                "$install_dir/$payload" >/dev/null 2>&1; then
        update_available=true
        break
    fi
done

if [[ "$update_available" != true ]]; then
    printf '[%s] Already up to date\n' "$(date --iso-8601=seconds)" \
        >> "$log_file"
    printf "You're already up to date! :3\n"
    exit 0
fi

{
    printf '[%s] Installing update\n' "$(date --iso-8601=seconds)"
    "$temporary_dir/source/install.sh" --update --yes \
        --no-install-deps --no-migrate-v1 --prefix="$install_dir"
    printf '[%s] Update completed\n' "$(date --iso-8601=seconds)"
} >> "$log_file" 2>&1

notify-send -a "Ayame Updater" "Ayame Shell V2 updated :3" \
    "The shell has been restarted with the newest build." \
    2>/dev/null || true
printf 'Ayame Shell V2 updated successfully! :3\n'
