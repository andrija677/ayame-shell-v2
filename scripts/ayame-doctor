#!/usr/bin/env bash
set -u

row() {
    local id="$1" label="$2" state="$3" detail="$4"
    detail="${detail//$'\n'/ }"; detail="${detail//|//}"
    printf '%s|%s|%s|%s\n' "$id" "$label" "$state" "$detail"
}

case "${1:-status}" in
    test-notification)
        notify-send -a "Ayame V2 Diagnostics" -t 5000 \
            "Notification test" "Ayame V2 notification delivery is working :3" >/dev/null 2>&1 &
        exit 0 ;;
    status) ;;
    *) printf 'Usage: %s {status|test-notification}\n' "$0" >&2; exit 2 ;;
esac

pgrep -x qs >/dev/null 2>&1 \
    && row quickshell "Quickshell" healthy "$(qs --version 2>/dev/null | head -n 1)" \
    || row quickshell "Quickshell" error "No qs process detected"
hyprland_line="$(Hyprland --version 2>/dev/null | head -n 1 || true)"
[[ "$hyprland_line" =~ Hyprland[[:space:]]+([0-9]+)\.([0-9]+) ]] \
    && row hyprland "Hyprland" healthy "$hyprland_line" \
    || row hyprland "Hyprland" error "${hyprland_line:-Missing}"
timeout 3 pw-dump >/dev/null 2>&1 \
    && row pipewire "PipeWire" healthy "Audio service reachable" \
    || row pipewire "PipeWire" error "PipeWire unavailable"
nmcli networking 2>/dev/null | grep -qx enabled \
    && row network "NetworkManager" healthy "Networking enabled" \
    || row network "NetworkManager" warning "Networking disabled or unavailable"
command -v cliphist >/dev/null 2>&1 && command -v wl-paste >/dev/null 2>&1 \
    && row clipboard "Clipboard support" healthy "cliphist and wl-clipboard available" \
    || row clipboard "Clipboard support" unavailable "Install cliphist and wl-clipboard"
command -v hyprsunset >/dev/null 2>&1 \
    && row nightlight "Night Light" healthy "hyprsunset available" \
    || row nightlight "Night Light" unavailable "Install hyprsunset"
command -v hypridle >/dev/null 2>&1 \
    && row idle "Idle management" healthy "hypridle available" \
    || row idle "Idle management" unavailable "Install hypridle"
monitor_json="$(hyprctl monitors -j 2>/dev/null || true)"
command -v jq >/dev/null 2>&1 && jq -e 'length > 0' >/dev/null 2>&1 <<<"$monitor_json" \
    && row displays "Display controls" healthy "Monitor modes and scaling available" \
    || row displays "Display controls" unavailable "jq or Hyprland IPC unavailable"
required=(grim slurp wf-recorder wl-copy wl-paste kitty matugen curl pw-dump nmcli notify-send python3)
missing=()
for command_name in "${required[@]}"; do
    command -v "$command_name" >/dev/null 2>&1 || missing+=("$command_name")
done
((${#missing[@]} == 0)) \
    && row dependencies "Core dependencies" healthy "All required commands found" \
    || row dependencies "Core dependencies" error "Missing: ${missing[*]}"
